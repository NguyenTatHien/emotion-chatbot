{
	auto_https off
	admin off
}

:80 {
	encode gzip zstd

	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
			transport http {
				read_timeout 90s
			}
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
