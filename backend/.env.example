# Sao chép thành `.env` rồi chỉnh. Không commit file `.env`.

# Chế độ mặc định cho mọi module: mock | local | remote
MODEL_MODE=mock

# Ghi đè mode cho từng module (để trống = dùng MODEL_MODE).
# Ví dụ khi Người 5 xong music: MUSIC_MODE=local
EMOTION_MODE=
SPEECH_MODE=
SAFETY_MODE=
# LLM_MODE còn nhận thêm "gemini": dùng Gemini API làm nguồn trả lời chính (cần GEMINI_API_KEY).
LLM_MODE=
MUSIC_MODE=

# Model server trên Colab (bắt buộc khi có module emotion/speech/llm ở mode remote).
# Safety và music KHÔNG dùng được mode remote.
MODEL_SERVER_URL=
# Bí mật dùng chung với model server (header X-Model-Server-Token); để trống nếu server không đặt.
MODEL_SERVER_TOKEN=

# Timeout từng lời gọi HTTP tới model server (giây)
REMOTE_TIMEOUT_EMOTION=10
REMOTE_TIMEOUT_TRANSCRIBE=20
REMOTE_TIMEOUT_PROSODY=10
REMOTE_TIMEOUT_GENERATE=30

# Gemini: nguồn chính khi LLM_MODE=gemini, dự phòng khi Qwen lỗi (trống khoá = bỏ qua).
# flash-lite: hạn mức miễn phí rộng hơn; gemini-3.8-flash: thông minh hơn nhưng ít lượt miễn phí.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Đánh giá thích/không thích: file JSONL và token xuất CSV (để trống ADMIN_TOKEN = tắt route export)
FEEDBACK_PATH=data/runtime/feedback.jsonl
ADMIN_TOKEN=

# Đường dẫn file danh sách bài hát (tính từ thư mục backend)
SONGS_CSV=data/songs.csv

# Giới hạn audio
MAX_AUDIO_SECONDS=30
MAX_AUDIO_MB=5

# Đường dẫn/tên ffmpeg (mặc định tìm `ffmpeg` trên PATH; dev có thể dùng imageio-ffmpeg)
FFMPEG_BINARY=ffmpeg

# Số lượt gần nhất truyền cho LLM
HISTORY_TURNS=6

# Các origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout từng module (giây)
SAFETY_TIMEOUT=5
EMOTION_TIMEOUT=10
LLM_TIMEOUT=30
MUSIC_TIMEOUT=5
SPEECH_TIMEOUT=20
PROSODY_TIMEOUT=10

# Dòng hỗ trợ thêm vào thông điệp an toàn (Người 3 cung cấp và kiểm chứng số). Để trống nếu chưa có.
SAFETY_HOTLINE_TEXT=

# Giả độ trễ cho mock (mili giây) để thử giao diện
MOCK_LATENCY_MS=0
