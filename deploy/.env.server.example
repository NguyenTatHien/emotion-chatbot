# Sao chép thành /opt/emotion-chatbot/.env trên server rồi điền giá trị thật.
# Tạo tay một lần trên server; KHÔNG commit và KHÔNG copy từ máy dev bằng script.

# Server không có GPU nên không chạy mô hình cục bộ: dùng mock hoặc remote (Colab).
MODEL_MODE=mock
# Khi dùng Colab: đặt EMOTION_MODE=remote, SPEECH_MODE=remote, LLM_MODE=remote
# và điền MODEL_SERVER_URL / MODEL_SERVER_TOKEN.
EMOTION_MODE=
SPEECH_MODE=
LLM_MODE=
MODEL_SERVER_URL=
MODEL_SERVER_TOKEN=

# Dự phòng Gemini (để trống = bỏ qua)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Token xuất CSV đánh giá; để trống = tắt route export
ADMIN_TOKEN=

# Dòng hỗ trợ thêm vào thông điệp an toàn (để trống nếu chưa có số đã kiểm chứng)
SAFETY_HOTLINE_TEXT=

# Cùng origin qua javis-proxy nên không cần CORS cho trình duyệt; giữ domain để rõ ràng
CORS_ORIGINS=https://emotion.hiennguyen.io.vn
